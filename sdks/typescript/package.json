{
  "name": "@pure-lambda/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for Pure Lambda",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/s0fractal/pure-lambda.git"
  },
  "author": "Pure Lambda Foundation",
  "license": "MIT",
  "keywords": [
    "pure-lambda",
    "distributed",
    "agent",
    "blockchain",
    "ipld",
    "receipts"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc src/index.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@ipld/dag-cbor": "^9.0.0",
    "@ipld/dag-json": "^10.0.0",
    "@noble/ed25519": "^2.0.0",
    "@noble/hashes": "^1.3.0",
    "multiformats": "^12.0.0",
    "uint8arrays": "^4.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "browser": {
    "crypto": false,
    "fs": false,
    "path": false
  },
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./agent": {
      "import": "./dist/agent.esm.js",
      "require": "./dist/agent.js",
      "types": "./dist/agent.d.ts"
    },
    "./receipt": {
      "import": "./dist/receipt.esm.js",
      "require": "./dist/receipt.js",
      "types": "./dist/receipt.d.ts"
    }
  }
}