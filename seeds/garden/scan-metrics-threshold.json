{
  "name": "scan-metrics-threshold",
  "description": "Threshold aggregator for metric scanning",
  "version": 1,
  "xidv2": "a1b2c3d4e5f6789012345678901234567890abcd",
  "nodes": [
    { "id": 0, "op": "ENTER", "config": {} },
