    { "id": 3, "op": "THRESHOLD", "config": { "min": 0.1, "max": 0.9 } },
    { "id": 4, "op": "AGGREGATE", "config": { "method": "mean" } },
    { "id": 5, "op": "EXIT", "config": {} }
  ],
  "edges": [
    [0, 1],
    [1, 2],
    [2, 3],
    [3, 4],
    [4, 5]
  ],
  "constraints": {
    "maxNodes": 100,
    "maxEdges": 200,
    "maxLatency": 100
  },
  "metadata": {
    "pattern": "scan-metrics",
    "novelty": 0.41,
    "trust": 98,
    "conformance": 96
  }
}