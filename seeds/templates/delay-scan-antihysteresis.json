{
  "name": "delay-scan-antihysteresis",
  "version": 1,
  "intent": "Pull noise to stable level with anti-hysteresis",
  "size": "≤10KB",
  "novelty": 0.58,
  "nodes": {
    "entry": {
      "op": "ENTER",
      "params": {}
    },
    "delay": {
      "op": "DELAY",
      "params": {
        "ms": 50,
        "jitter": false
      }
    },
    "scan": {
      "op": "SCAN",
      "params": {
        "window": 20,
        "filter": "median"
      }
    },
    "antihysteresis": {
      "op": "STABILIZE",
      "params": {
        "band": 0.1,
        "deadzone": 0.05
      }
    },
    "exit": {
      "op": "EXIT",
      "params": {}
    }
  },
  "edges": [
    ["entry", "delay"],
    ["delay", "scan"],
    ["scan", "antihysteresis"],
    ["antihysteresis", "exit"]
  ],
  "fixtures": [
    {"noise": [0.1, 0.9, 0.2, 0.8], "expected": 0.5},
    {"noise": [0.5, 0.5, 0.5], "expected": 0.5}
  ],
  "xidv2": "delay-scan-antihysteresis-v2-${timestamp}"
}