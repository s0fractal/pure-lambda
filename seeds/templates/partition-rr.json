{
  "name": "partition-rr",
  "version": 1,
  "intent": "Fair round-robin scheduling across branches",
  "size": "≤10KB",
  "novelty": 0.51,
  "nodes": {
    "entry": {
      "op": "ENTER",
      "params": {}
    },
    "split": {
      "op": "SPLIT",
      "params": {
        "n": 3,
        "policy": "partition"
      }
    },
    "scan": {
      "op": "SCAN",
      "params": {
        "policy": "round-robin"
      }
    },
    "merge": {
      "op": "MERGE",
      "params": {
        "fair": true
      }
    },
    "exit": {
      "op": "EXIT",
      "params": {}
    }
  },
  "edges": [
    ["entry", "split"],
    ["split", "scan"],
    ["scan", "merge"],
    ["merge", "exit"]
  ],
  "fixtures": [
    {"events": 1000, "expected": {"branch1": 333, "branch2": 333, "branch3": 334}}
  ],
  "xidv2": "partition-rr-v2-${timestamp}"
}