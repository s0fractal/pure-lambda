{
  "name": "split-metric-select",
  "version": 1,
  "intent": "Branch based on local metric temperature",
  "size": "≤10KB",
  "novelty": 0.56,
  "nodes": {
    "entry": {
      "op": "ENTER",
      "params": {}
    },
    "metric": {
      "op": "MEASURE",
      "params": {
        "type": "temperature",
        "window": 5
      }
    },
    "split": {
      "op": "SPLIT",
      "params": {
        "branches": ["hot", "warm", "cold"]
      }
    },
    "select": {
      "op": "SELECT",
      "params": {
        "based_on": "${metric.temp}",
        "thresholds": {
          "hot": 0.7,
          "warm": 0.4,
          "cold": 0.0
        }
      }
    },
    "merge": {
      "op": "MERGE",
      "params": {}
    },
    "exit": {
      "op": "EXIT",
      "params": {}
    }
  },
  "edges": [
    ["entry", "metric"],
    ["metric", "split"],
    ["split", "select"],
    ["select", "merge"],
    ["merge", "exit"]
  ],
  "fixtures": [
    {"temp": 0.8, "expected": "hot"},
    {"temp": 0.5, "expected": "warm"},
    {"temp": 0.2, "expected": "cold"}
  ],
  "xidv2": "split-metric-select-v2-${timestamp}"
}