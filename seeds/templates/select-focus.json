{
  "name": "select-focus",
  "version": 1,
  "intent": "Conditional routing with branch highlighting",
  "size": "≤10KB",
  "novelty": 0.42,
  "nodes": {
    "entry": {
      "op": "ENTER",
      "params": {}
    },
    "selector": {
      "op": "SELECT",
      "params": {
        "condition": "${branch}",
        "default": "main"
      }
    },
    "focus": {
      "op": "FOCUS",
      "params": {
        "target": "${selector.output}",
        "highlight": true
      }
    },
    "exit": {
      "op": "EXIT",
      "params": {}
    }
  },
  "edges": [
    ["entry", "selector"],
    ["selector", "focus"],
    ["focus", "exit"]
  ],
  "fixtures": [
    {"branch": "main", "expected": "main"},
    {"branch": "alt", "expected": "alt"},
    {"branch": null, "expected": "main"},
    {"branch": "other", "expected": "main"}
  ],
  "xidv2": "select-focus-v2-${timestamp}"
}