{
  "name": "@s0fractal/pure-lambda-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Pure Lambda - Cross-dimensional genetics",
  "workspaces": [
    "packages/*",
    "organisms/*/dist/ts"
  ],
  "scripts": {
    "build": "node organism-cli.js make core",
    "build:tools": "tsup tools/*.ts --format esm --dts --splitting false",
    "test": "node test-lambda-pure.js",
    "test:organism": "node organism-cli.js test core",
    "verify": "node gene-cli.js verify map && node gene-cli.js verify filter",
    "soulset": "node organism-cli.js soulset core",
    "gid:file": "ts-node tools/gid.ts",
    "ipld:car": "ts-node tools/ipld-export.ts fixtures/tiles dist/operon.car --json dist/operon.json",
    "autopilot:json": "ts-node tools/autopilot.ts dist/operon.json --k 5",
    "receipt:make": "ts-node tools/receipts.ts dist/operon.json dist/operon.car > receipts/last.json",
    "receipt:verify": "ts-node tools/receipts.ts --verify receipts/last.json",
    "attest:make": "node scripts/attest/build.mjs receipts/attest/provenance.json > receipts/attest/envelope.json",
    "attest:verify": "node scripts/attest/verify.mjs receipts/attest/envelope.json",
    "attest:audit": "node scripts/attest/audit.mjs",
    "attest:resign": "node scripts/attest/resign.mjs",
    "attest:verify:all": "node scripts/attest/verify.mjs --all",
    "biolock:rename": "node scripts/biolock/rename.mjs",
    "spdx:check": "node scripts/licenses/spdx-scan.mjs",
    "spdx:write": "node scripts/licenses/spdx-scan.mjs --write",
    "licenses:policy": "node scripts/licenses/policy.mjs",
    "licenses:notices": "node scripts/licenses/generate-notices.mjs",
    "release:local": "node scripts/release/local.mjs",
    "release:tag": "node scripts/release/tag.mjs",
    "notes:rc": "ts-node tools/notes.ts",
    "test:conformance": "node scripts/ga/conformance.mjs",
    "pack": "ts-node tools/seed/pack.ts",
    "cartridge:htmlc": "ts-node tools/cartridge/pack-htmlc.ts",
    "cartridge:zip": "ts-node tools/cartridge/pack-zip.ts",
    "cartridge:verify": "ts-node tools/cartridge/verify.ts",
    "fed:ingest": "ts-node tools/fed/ingest.ts",
    "fed:bundle": "ts-node tools/fed/bundle.ts",
    "fed:verify": "ts-node tools/fed/verify.ts",
    "fed:index": "ts-node tools/fed/index.ts",
    "air:pack": "ts-node tools/air/pack.ts dist/release/hello-city.cartridge",
    "air:recv": "ts-node tools/air/recv-assemble.ts --sharecodes dist/air/sharecodes.txt",
    "ck:qr": "ts-node tools/ck/qrcode.ts",
    "ck:validate": "node scripts/ck/validate.mjs",
    "ck:bundle": "node scripts/ck/bundle.mjs",
    "ck:pr": "node scripts/ck/pr.mjs",
    "ck:smoke": "node tests/ck/ck-smoke.mjs"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "esbuild": "^0.25.9",
    "tsup": "^8.5.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s0fractal/pure-lambda.git"
  },
  "keywords": [
    "lambda",
    "functional",
    "cross-language",
    "genetics",
    "soul"
  ],
  "author": "s0fractal",
  "license": "MIT",
  "main": "devour-cli.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/s0fractal/pure-lambda/issues"
  },
  "homepage": "https://github.com/s0fractal/pure-lambda#readme",
  "dependencies": {
    "@ipld/car": "^5.4.2",
    "@ipld/dag-cbor": "^9.2.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.4.0",
    "chokidar": "^4.0.3",
    "commander": "^14.0.1",
    "js-yaml": "^4.1.0",
    "multiformats": "^13.4.1",
    "seedrandom": "^3.0.5",
    "ts-node": "^10.9.2",
    "ws": "^8.18.3",
    "yaml": "^2.8.1"
  }
}
