{
  "name": "@s0fractal/pure-lambda-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Pure Lambda - Cross-dimensional genetics",
  "workspaces": [
    "packages/*",
    "organisms/*/dist/ts"
  ],
  "scripts": {
    "build": "node organism-cli.js make core",
    "test": "node test-lambda-pure.js",
    "test:organism": "node organism-cli.js test core",
    "verify": "node gene-cli.js verify map && node gene-cli.js verify filter",
    "soulset": "node organism-cli.js soulset core"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s0fractal/pure-lambda.git"
  },
  "keywords": [
    "lambda",
    "functional",
    "cross-language",
    "genetics",
    "soul"
  ],
  "author": "s0fractal",
  "license": "MIT",
  "main": "devour-cli.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/s0fractal/pure-lambda/issues"
  },
  "homepage": "https://github.com/s0fractal/pure-lambda#readme",
  "dependencies": {
    "@types/node": "^24.4.0",
    "chokidar": "^4.0.3",
    "commander": "^14.0.1",
    "seedrandom": "^3.0.5",
    "ts-node": "^10.9.2",
    "ws": "^8.18.3"
  }
}
