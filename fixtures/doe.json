    {
      "name": "id_basic",
      "yaml": {
        "op": "id",
        "code": "x => x",
        "ports": {
          "in": "any",
          "out": "any"
        },
        "law": "identity",
        "cost": "O(1)"
      },
      "variants": [
        {
          "reason": "whitespace_changes",
          "mutate": {
            "code": "  x =>   x  "
          }
        },
        {
          "reason": "rename_variable",
          "mutate": {
            "code": "input => input"
          }
        },
        {
          "reason": "different_ports",
          "mutate": {
            "ports": {
              "input": "any",
              "output": "any"
            }
          }
        }
      ],
      "expect": {
        "gid_equal": [0, 1, 2],
        "iid_equal": [0, 1],
        "xid_diff": [0, 2]
      }
    },
