  "operons": [
    {
      "name": "split_merge_operon",
      "yaml": {
        "tiles": [
          {
            "name": "s1",
            "op": "SPLIT",
            "code": "x => [x.left, x.right]",
            "ports": {
              "in": "pair",
              "out1": "left",
              "out2": "right"
            }
          },
          {
            "name": "id1",
            "op": "id",
            "code": "x => x",
            "ports": {
              "in": "left",
              "out": "left"
            }
          },
          {
            "name": "scan1",
            "op": "SCAN",
            "code": "x => x.filter(v => v)",
            "ports": {
              "in": "right",
              "out": "filtered"
            }
          },
          {
            "name": "m1",
            "op": "MERGE",
            "code": "(l, r) => ({ left: l, right: r })",
            "ports": {
              "in1": "left",
              "in2": "filtered",
              "out": "merged"
            }
          }
        ],
        "connections": [
          { "from": "s1.out1", "to": "id1.in" },
          { "from": "s1.out2", "to": "scan1.in" },
          { "from": "id1.out", "to": "m1.in1" },
          { "from": "scan1.out", "to": "m1.in2" }
        ]
      },
      "variants": [
        {
          "reason": "change_neighbor_iid",
          "mutate": {
            "tiles": [
              {
                "name": "id1",
                "ports": {
                  "input": "left",
                  "output": "left"
                }
              }
            ]
          }
        }
      ],
      "expect": {
        "gid_equal": [0, 1],
        "iid_equal": [0],
        "xid_diff": [0, 1]
      }
    },
